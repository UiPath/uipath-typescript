# UiPath Integration Test Configuration
# Copy this file to .env.integration and fill in your actual values

# ============================================
# Required Configuration
# ============================================

# UiPath Cloud URL (e.g., https://cloud.uipath.com)
UIPATH_BASE_URL=https://cloud.uipath.com

# Base URL for suites that authenticate with a user access token (see
# UIPATH_USER_TOKEN below). Optional — falls back to UIPATH_BASE_URL.
# Set this when UIPATH_BASE_URL points at the CORS proxy: its path whitelist
# does not cover every service these suites reach, so they need the platform
# host directly.
MINTER_BASE_URL=

# Your UiPath organization name
UIPATH_ORG_NAME=your-organization-name

# Your UiPath tenant name
UIPATH_TENANT_NAME=your-tenant-name

# Personal Access Token (PAT) for authentication
# Generate this from UiPath Cloud > Admin > External Applications
UIPATH_SECRET=your-pat-token-here

# ============================================
# Optional: User Access Token
# ============================================

# Some services reject PAT and client-credentials tokens outright and only accept
# a user access token — everything under `insightsrtm_` (Agents, Agent Memory,
# Agent Traces, Governance) and the notification service. Those suites skip when
# this is unset, so leaving it empty is fine for a normal local run.
#
# To obtain one, use Minter (a headless browser login that exports the token):
#   az acr login -n pltnonprodacr
#   docker run --rm -v "$PWD/out:/out" pltnonprodacr.azurecr.io/uipath-minter:latest \
#     npm run generate -- -u <email> -p <password> -n <org> -t <tenant> -e <env> -v basic -o /out/tokens.json
# then copy the `accessToken` field from out/tokens.json.
#
# Note: the token is short-lived and is never refreshed by the SDK, so re-mint it
# if a run starts failing with 401s. Docs: https://uipath.atlassian.net/wiki/spaces/CLD/pages/87134404744
UIPATH_USER_TOKEN=

# ============================================
# Test Settings
# ============================================

# Test timeout in milliseconds (default: 30000)
INTEGRATION_TEST_TIMEOUT=30000

# Skip cleanup after tests (useful for debugging)
# Set to 'true' to preserve test data after runs
INTEGRATION_TEST_SKIP_CLEANUP=false

# Default folder ID for tests (optional)
# Leave empty to use default folder
INTEGRATION_TEST_FOLDER_ID=

# Folder key (GUID) matching INTEGRATION_TEST_FOLDER_ID
# Used by getByName integration tests for assets/processes
INTEGRATION_TEST_FOLDER_KEY=

# Folder path (e.g. "Shared/Finance") matching INTEGRATION_TEST_FOLDER_ID
# Used by getByName integration tests for assets/processes
INTEGRATION_TEST_FOLDER_PATH=

# Dedicated queue (by name, inside INTEGRATION_TEST_FOLDER_ID) used by the
# queue item / transaction integration tests — items are inserted into it
QUEUES_TEST_QUEUE_NAME=

# ============================================
# Optional: Pre-existing Test Data
# (for read-only tests that need existing resources)
# ============================================

# Maestro test process key
MAESTRO_TEST_PROCESS_KEY=

# Orchestrator test process key
ORCHESTRATOR_TEST_PROCESS_KEY=

# Data Fabric test entity ID
DATA_FABRIC_TEST_ENTITY_ID=
# Pre-existing folder-scoped Data Fabric entity ID — used by the folder-scoped
# record CRUD tests. Must live in the folder identified by INTEGRATION_TEST_FOLDER_KEY.
DATA_FABRIC_TEST_FOLDER_ENTITY_ID=
DATA_FABRIC_TEST_CHOICESET_ID=
DATA_FABRIC_TEST_ATTACHMENT_FIELD=
# Cross-entity join fixture for the queryRecordsById join test, describing one
# join from the entity under test (DATA_FABRIC_TEST_ENTITY_ID) to a related entity.
# DATA_FABRIC_TEST_JOIN_FIELD_NAME, DATA_FABRIC_TEST_JOIN_RELATED_ENTITY_NAME,
# and DATA_FABRIC_TEST_JOIN_RELATED_FIELD_NAME are required; the test throws
# when any of them are missing. DATA_FABRIC_TEST_JOIN_ENTITY_NAME is optional
# (defaults to the queried entity).
DATA_FABRIC_TEST_JOIN_ENTITY_NAME=
DATA_FABRIC_TEST_JOIN_FIELD_NAME=
DATA_FABRIC_TEST_JOIN_RELATED_ENTITY_NAME=
DATA_FABRIC_TEST_JOIN_RELATED_FIELD_NAME=

# Jobs test folder ID (folder containing jobs for resume/suspend tests)
# Falls back to INTEGRATION_TEST_FOLDER_ID if not set
JOBS_TEST_FOLDER_ID=

# Orchestrator attachment ID (UUID) for attachment getById tests
ORCHESTRATOR_ATTACHMENT_ID=

# Directory group ID used by the task assignment-criteria integration tests.
# The group must be assigned to the folder identified by INTEGRATION_TEST_FOLDER_ID.
TASKS_TEST_USER_GROUP_ID=

# User ID (from tasks.getUsers()) used by the single-user task assignment tests.
# The user must have task permissions in the folder identified by INTEGRATION_TEST_FOLDER_ID.
TASKS_TEST_USER_ID=

# Numeric ID of a folder containing at least one deployed coded function.
FUNCTIONS_TEST_FOLDER_ID=

# Name of a deployed coded function in FUNCTIONS_TEST_FOLDER_ID (used by invoke tests).
FUNCTIONS_TEST_FUNCTION_NAME=

# Conversational Agent (CAS) agent release ID for personal connections tests
CAS_TEST_AGENT_ID=
# Folder ID containing the CAS test agent
CAS_TEST_FOLDER_ID=