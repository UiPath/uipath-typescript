# Logs
logs
*.log
npm-debug.log*

# Build outputs
node_modules
dist
dist-ssr
.uipath

# The repo-root .gitignore has `lib/` to ignore build artifacts elsewhere
# in the monorepo. Un-ignore our application source `src/lib/` so its
# files (csvExport, entityTypes, utils, etc.) are tracked.
!src/lib/
!src/lib/**

