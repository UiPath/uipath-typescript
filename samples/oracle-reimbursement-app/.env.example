# Copy to `.env` and fill in the names from your tenant. Read by src/app-config.ts.
VITE_APP_NAME=Reimbursement
VITE_ENTITY_DEV=<dev entity name>
VITE_ENTITY_PROD=<prod entity name>
VITE_ADMIN_GROUP_DEV=<identity group whose members are admins in dev>
VITE_ADMIN_GROUP_PROD=<identity group whose members are admins in prod>
VITE_ASSET_RUNTIME=<asset holding "dev" or "prod">
VITE_ASSET_USER_LIST=<asset holding the comma-separated assignable users>
VITE_QUEUE_NAME=<performer queue name>
VITE_QUEUE_FOLDER_PATH=<Orchestrator folder path of that queue>
