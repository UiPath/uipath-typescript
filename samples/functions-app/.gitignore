node_modules
dist
dist-ssr
*.local
.uipath
*.nupkg

# Only the app's own OAuth config — copy uipath.json.example to uipath.json.
# Anchored, so it does not swallow coded-functions/uipath.json (the functions map).
/uipath.json

# The repo root ignores `lib/` as an SDK build output; here it is hand-written source.
!coded-functions/lib/
!coded-functions/lib/**

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.env

# Generated by `uip functions pack` — regenerated on every pack, and they carry
# trigger GUIDs from whichever tenant packed them.
coded-functions/entry-points.json
coded-functions/bindings_v2.json
