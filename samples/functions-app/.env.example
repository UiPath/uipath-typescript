# OAuth config (client id, org, tenant, base URL) lives in uipath.json —
# copy uipath.json.example to uipath.json and fill it in.
#
# The only app-specific value is the folder the coded functions are deployed to.
# This is the folder's NUMERIC id, not its key (GUID). Find it with:
#   uip or folders list
VITE_UIPATH_FOLDER_ID=your-numeric-folder-id-here
