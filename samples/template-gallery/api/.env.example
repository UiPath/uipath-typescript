# Platform coordinates the function would get from ctx.platform when deployed.
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ORG_ID=<org-guid>
UIPATH_TENANT_ID=<tenant-guid>

# Template storage: the folder that holds index.json and <template>/<version>/.
TEMPLATES_STORAGE_BASE=https://<account>.blob.core.windows.net/<container>/templates

# Browser origin allowed to call this host (the gallery dev server)
CORS_ORIGIN=http://localhost:5173
