# Folder that holds index.json and <template>/<version>/ (public read)
# The backend: GET /templates (catalog) and POST /copies (edit), local host or uip function serve
VITE_COPIES_API=http://localhost:7070
# Server-side only (Vite dev plugin): the folder that holds index.json and <template>/<version>/
TEMPLATES_STORAGE_BASE=https://<account>.blob.core.windows.net/<container>/templates
# Optional defaults for the Deploy form (your external app and folder)
VITE_DEFAULT_CLIENT_ID=
VITE_DEFAULT_FOLDER_KEY=
