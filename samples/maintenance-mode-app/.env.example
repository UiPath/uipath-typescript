# OAuth config (client id, org, tenant, base URL) lives in uipath.json —
# copy uipath.json.example to uipath.json and fill it in.
#
# Nothing here is required. Two optional knobs:

# Data Fabric entity holding app settings as Key/Value rows. Defaults to AppSettings.
# VITE_SETTINGS_ENTITY_NAME=AppSettings

# Row key for this app's maintenance switch. Defaults to MaintenanceMode:<client id>,
# so each app gets its own switch in the shared entity. Pin a key here if the app's
# client id may change — a new client id otherwise means a new row, reading as off.
# VITE_MAINTENANCE_SETTING_KEY=MaintenanceMode:my-app
